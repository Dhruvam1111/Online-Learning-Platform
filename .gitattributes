# ==============================================================================
# Git Attributes - Line Ending & Binary Normalization
# ==============================================================================

# Auto detect text files and perform LF normalization
* text=auto eol=lf

# ------------------------------------------------------------------------------
# Source Code & Text Configurations
# ------------------------------------------------------------------------------
*.java          text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.json          text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.xml           text eol=lf
*.sql           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
*.properties    text eol=lf
*.env*          text eol=lf
*.sh            text eol=lf

# ------------------------------------------------------------------------------
# Windows Shell Scripts
# ------------------------------------------------------------------------------
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# ------------------------------------------------------------------------------
# Binary Formats
# ------------------------------------------------------------------------------
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.jar           binary
*.docx          binary
*.xlsx          binary

