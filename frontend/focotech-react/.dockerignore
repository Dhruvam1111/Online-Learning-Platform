# ──────────────────────────────────────────────────────────────
# .dockerignore  –  frontend/focotech-react/
# Keeps the Docker build context lean, fast and secret-free.
# ──────────────────────────────────────────────────────────────

# Node modules — reinstalled inside the container via npm ci
node_modules/

# Vite production / preview build output
dist/
dist-ssr/

# Git history
.git/
.gitignore
.gitattributes

# GitHub Actions / CI
.github/

# Local environment files — may contain API keys or secrets
.env
.env.*
*.env
*.local

# IDE / editor metadata
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?

# OS artefacts
.DS_Store
Thumbs.db
desktop.ini

# Log files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test output and coverage
coverage/
*.lcov
.nyc_output/

# TypeScript incremental build info
*.tsbuildinfo

# Storybook / docs build output (if added later)
storybook-static/

# Temporary files
*.tmp
*.bak

