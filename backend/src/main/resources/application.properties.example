# ==============================================================================
# Online Learning Platform - Example Environment Configuration
# Copy this file to application.properties and fill in your credentials.
# NEVER commit application.properties to version control.
# ==============================================================================

# Database Connection (Neon Cloud or Local PostgreSQL)
spring.datasource.url=jdbc:postgresql://<HOST>:<PORT>/<DATABASE>?sslmode=require
spring.datasource.username=<USERNAME>
spring.datasource.password=<PASSWORD>
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# JWT Security
jwt.secret=<YOUR_BASE64_ENCODED_256BIT_SECRET>
jwt.expiration=86400000

# Server Port
server.port=8080

# CORS Configuration (optional, defaults to localhost:* and 127.0.0.1:*)
# Set to your deployed frontend domain (e.g. https://my-app.vercel.app or comma-separated list)
app.cors.allowed-origins=${FRONTEND_URL:}

