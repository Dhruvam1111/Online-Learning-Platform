# ==============================================================================
# Online Learning Platform - Example Environment Configuration
# Copy this file to application.properties and fill in your credentials.
# NEVER commit application.properties to version control.
# ==============================================================================

# Database Connection (Neon Cloud or Local PostgreSQL)
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://<HOST>:<PORT>/<DATABASE>?sslmode=require}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:<USERNAME>}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:<PASSWORD>}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# JWT Security
app.jwt.secret=${JWT_SECRET:this-is-a-dev-only-secret-key-that-must-be-at-least-256-bits-long-for-HS256}
app.jwt.expiration-ms=${JWT_EXPIRATION_MS:86400000}
jwt.secret=${JWT_SECRET:this-is-a-dev-only-secret-key-that-must-be-at-least-256-bits-long-for-HS256}
jwt.expiration=${JWT_EXPIRATION_MS:86400000}

# Server Port
server.port=${PORT:8080}

# Application Base URLs (for email verification, password resets, and redirect links)
app.public-api-url=${PUBLIC_API_URL:http://localhost:8080}
app.frontend-url=${FRONTEND_URL:http://localhost:3000}

# File Upload Configuration (FR-I04: Profile Picture & Credentials)
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=15MB
app.upload.dir=uploads

# CORS Configuration (optional, defaults to localhost:* and 127.0.0.1:*)
app.cors.allowed-origins=${FRONTEND_URL:}

# Bounded Async Task Executor
app.async.core-pool-size=${ASYNC_CORE_POOL_SIZE:4}
app.async.max-pool-size=${ASYNC_MAX_POOL_SIZE:16}
app.async.queue-capacity=${ASYNC_QUEUE_CAPACITY:100}
app.async.thread-name-prefix=olp-async-
app.async.await-termination-seconds=30


